{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elenchia",
  "version": "1.4.0",
  "identifier": "app.elenchia.lab",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Elenchia",
        "decorations": false,
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#0A0A0A"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "category": "Education",
    "shortDescription": "Direct an AI research lab. Local models first.",
    "longDescription": "Elenchia is a local-first desktop app where you staff a lab of AI agents, point them at a research question, and approve what they do. Agents run on local models (LM Studio or Ollama).",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "linux": { "deb": { "depends": [] } }
  }
}
